# ─── AI API Keys ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here

# ─── Web Search ───────────────────────────────────────────────────────────────
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=your_tavily_key_here

# ─── Web UI ───────────────────────────────────────────────────────────────────
# Port for the trident UI server (default: 4242)
# TRIDENT_UI_PORT=4242

# ─── Optional External APIs ───────────────────────────────────────────────────
# Add keys here as needed — reference them in packages/mcp-server/src/tools/api.ts
# NEWSAPI_KEY=
# POLYGON_API_KEY=
# FINNHUB_API_KEY=

# ─── Google Workspace ─────────────────────────────────────────────────────────
# No env vars needed — Google integration uses OAuth via credentials.json + data/google-token.json.
# Run `trident google login` after placing credentials.json at the repo root.

# ─── Builder Module ───────────────────────────────────────────────────────────
# Default tier for new builds (main | premium | fast). Per-build flags override.
# TRIDENT_BUILDER_DEFAULT_TIER=main
# Hard cost ceiling per build (USD). Pause + prompt user when hit.
# TRIDENT_BUILDER_COST_USD_MAX=5.00
# Wall-clock ceiling per build (minutes). Pause when hit.
# TRIDENT_BUILDER_WALL_CLOCK_MAX_MIN=60
# Sandbox backend: worktree (v1, default) | docker (v2, not yet implemented).
# TRIDENT_BUILDER_SANDBOX=worktree

# ─── Builder — Cloud deployment (Railway, etc.) ───────────────────────────────
# Pin the Builder to a specific git repo for the deployed instance. Accepts a
# local path OR a remote git URL (https://github.com/owner/repo.git, ssh, etc.).
# When set, the UI auto-fills the "Source repo" field and the API allows
# omitting source_repo in build requests.
# TRIDENT_BUILDER_DEFAULT_REPO=https://github.com/wpf002/trident.git
# Default base branch for new builds (default: main).
# TRIDENT_BUILDER_DEFAULT_BASE_BRANCH=main
# Override the data directory — point this at a Railway volume mount so
# builds/repos/SQLite persist across deploys. Default: <repo>/data
# TRIDENT_DATA_DIR=/data
# GitHub token for cloning private repos and (later) pushing commits.
# TRIDENT_GITHUB_TOKEN=ghp_…
# Git committer identity used inside Builder workspaces.
# TRIDENT_BUILDER_GIT_USER_NAME="Trident Builder"
# TRIDENT_BUILDER_GIT_USER_EMAIL="builder@trident.local"
