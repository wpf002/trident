# ─── AI API Keys ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here

# ─── Web Search ───────────────────────────────────────────────────────────────
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=your_tavily_key_here

# ─── Web UI ───────────────────────────────────────────────────────────────────
# Port for the trident UI server (default: 4242)
# TRIDENT_UI_PORT=4242

# ─── Optional External APIs ───────────────────────────────────────────────────
# Add keys here as needed — reference them in packages/mcp-server/src/tools/api.ts
# NEWSAPI_KEY=
# POLYGON_API_KEY=
# FINNHUB_API_KEY=

# ─── Google Workspace ─────────────────────────────────────────────────────────
# No env vars needed — Google integration uses OAuth via credentials.json + data/google-token.json.
# Run `trident google login` after placing credentials.json at the repo root.
