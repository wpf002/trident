# ─── AI API Keys ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here

# ─── Web Search ───────────────────────────────────────────────────────────────
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=your_tavily_key_here

# ─── Models ───────────────────────────────────────────────────────────────────
# Global default max OUTPUT tokens per AI call. Defaults: 16384 (main/premium),
# 4096 (utility). Raise this if long answers still get cut off; each provider is
# clamped to its own ceiling automatically (Claude/GPT 16384, Perplexity 8192).
# Costs nothing extra — you only pay for tokens actually generated.
# TRIDENT_MAX_OUTPUT_TOKENS=16384

# ─── Web UI ───────────────────────────────────────────────────────────────────
# Port for the trident UI server (default: 4242)
# TRIDENT_UI_PORT=4242

# Interface to bind. Defaults to 0.0.0.0 (all interfaces). When deploying the UI
# server publicly you MUST set TRIDENT_API_TOKEN below; otherwise bind locally:
# HOST=127.0.0.1

# Shared bearer token that protects the /api routes. When set, the UI prompts
# for it once and every API request must carry `Authorization: Bearer <token>`.
# Generate one with:  openssl rand -hex 32
# TRIDENT_API_TOKEN=

# Comma-separated CORS origin allowlist for cross-origin browser access.
# The same-origin UI does not need this; leave empty to block all cross-origin.
# TRIDENT_ALLOWED_ORIGINS=https://trident.example.com

# ─── Optional External APIs ───────────────────────────────────────────────────
# Add keys here as needed — reference them in packages/mcp-server/src/tools/api.ts
# NEWSAPI_KEY=
# POLYGON_API_KEY=
# FINNHUB_API_KEY=

# ─── Google Workspace ─────────────────────────────────────────────────────────
# Google integration uses OAuth via credentials.json + data/google-token.json.
# Run `trident google login` after placing credentials.json at the repo root.
#
# Optional: encrypt the stored OAuth token at rest (AES-256-GCM). When set, the
# token file is encrypted with a key derived from this value; the same value
# must be present when the MCP server reads it. Without it the token is stored
# as plaintext but always with 0600 (owner-only) permissions.
# Generate one with:  openssl rand -hex 32
# TRIDENT_TOKEN_KEY=
